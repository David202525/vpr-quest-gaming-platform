{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без токена доступа нет",
      "method": "GET",
      "path": "/?action=parent-dashboard",
      "expectedStatus": 401
    },
    {
      "name": "Назначение без токена запрещено",
      "method": "POST",
      "path": "/?action=assign",
      "body": {"child_id": 1, "topic": "Дроби"},
      "expectedStatus": 401
    }
  ]
}
